#!/usr/bin/env bash
# cdocker — launch the Claude Code Docker image as a tmux session.
#
# Designed for "totally unknown host" use: rclone carries the credentials,
# the host needs no claude install. Container pulls credentials from
# CDOCKER_REMOTE at startup; pushes rotated tokens back on clean exit.
#
# To refresh the remote with fresh tokens (run on a host that IS authenticated
# with claude), use the sibling script `cdocker-push`.
#
# Configuration is loaded from `.env` next to this script (gitignored). Copy
# `.env.template` to `.env` and edit it before first use.
#
# Override at invocation time:
#   --rclone-conf <path>   (or --rclone-conf=<path>)
#   --remote      <spec>   (or --remote=<spec>)
#   --verify               run a non-interactive auth check, no tmux. Exits 0
#                          if Claude responded; non-zero if auth failed.
#   --build                build the image before running (one-time setup, or
#                          after a Dockerfile/entrypoint change)
#   --build-only           build the image and exit (no docker run)
#   CDOCKER_RCLONE_CONF=<path>   (env)
#   CDOCKER_REMOTE=<spec>        (env)
#   CDOCKER_IMAGE=<tag>          (env, default: claude-code)
#
# <rclone-conf> may be a directory or a single rclone.conf file.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

if [[ -f "$SCRIPT_DIR/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$SCRIPT_DIR/.env"
  set +a
fi

REMOTE="${CDOCKER_REMOTE:-}"
RCLONE_CONF="${CDOCKER_RCLONE_CONF:-$HOME/.config/rclone}"
IMAGE="${CDOCKER_IMAGE:-claude-code}"
CONTAINER_HOME="${CDOCKER_CONTAINER_HOME:-/home/claude-runner}"

BUILD=0
BUILD_ONLY=0
VERIFY=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --rclone-conf)        RCLONE_CONF="$2"; shift 2 ;;
    --rclone-conf=*)      RCLONE_CONF="${1#*=}"; shift ;;
    --remote)             REMOTE="$2"; shift 2 ;;
    --remote=*)           REMOTE="${1#*=}"; shift ;;
    --verify)             VERIFY=1; shift ;;
    --build)              BUILD=1; shift ;;
    --build-only)         BUILD=1; BUILD_ONLY=1; shift ;;
    --)                   shift; break ;;
    *)                    break ;;
  esac
done

if [[ "$BUILD" -eq 1 ]]; then
  echo "cdocker: building image '$IMAGE' from $SCRIPT_DIR ..." >&2
  docker build \
    --build-arg UID="$(id -u)" \
    --build-arg GID="$(id -g)" \
    -t "$IMAGE" \
    "$SCRIPT_DIR"
  [[ "$BUILD_ONLY" -eq 1 ]] && exit 0
fi

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  cat >&2 <<EOF
cdocker: image '$IMAGE' is not built locally and is not on Docker Hub.
  Build it once with:
    $0 --build
  Or manually:
    docker build -t $IMAGE $SCRIPT_DIR
EOF
  exit 1
fi

if [[ -z "$REMOTE" ]]; then
  cat >&2 <<EOF
cdocker: CDOCKER_REMOTE is unset.
  Copy $SCRIPT_DIR/.env.template to .env and set it,
  or pass --remote <remote>:<path> on the command line.
EOF
  exit 1
fi

declare -a MOUNT_OPTS=()
if [[ -d "$RCLONE_CONF" ]]; then
  MOUNT_OPTS+=(-v "$RCLONE_CONF:$CONTAINER_HOME/.config/rclone")
elif [[ -f "$RCLONE_CONF" ]]; then
  MOUNT_OPTS+=(
    -v "$RCLONE_CONF:$CONTAINER_HOME/.config/rclone/rclone.conf"
    -e "RCLONE_CONFIG=$CONTAINER_HOME/.config/rclone/rclone.conf"
  )
else
  echo "cdocker: rclone config not found at $RCLONE_CONF" >&2
  exit 1
fi

declare -a TTY_OPTS=(-it)
declare -a RUN_OPTS=()
if [[ "$VERIFY" -eq 1 ]]; then
  TTY_OPTS=()
  RUN_OPTS+=(-e "CDOCKER_VERIFY=1")
fi

docker run --rm "${TTY_OPTS[@]}" \
  -e TERM="${TERM:-xterm-256color}" \
  -e CDOCKER_REMOTE="$REMOTE" \
  "${RUN_OPTS[@]}" \
  "${MOUNT_OPTS[@]}" \
  -v "$PWD:$PWD" -w "$PWD" \
  "$IMAGE" "$@"
