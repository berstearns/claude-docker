# Copy this file to `.env` (which is gitignored) and edit the values.
# Variables set here are read by the cdocker and cdocker-push wrappers
# before each invocation.

# REQUIRED. Rclone remote + path holding your Claude Code credentials.
# Format: <remote>:<path>  (use whatever name your rclone.conf gives the remote)
# Example for a remote named "drive": drive:/claude-code/deploy
CDOCKER_REMOTE=

# OPTIONAL. Path to your rclone config — directory OR single rclone.conf file.
# Leave empty to use ~/.config/rclone (the standard location).
# Examples:
#   CDOCKER_RCLONE_CONF=/home/me/.config/rclone
#   CDOCKER_RCLONE_CONF=/home/me/.config/rclone/rclone-work.conf
CDOCKER_RCLONE_CONF=

# OPTIONAL. Docker image tag the wrapper invokes. Match what `docker build`
# tagged the image as. Defaults to "claude-code".
CDOCKER_IMAGE=claude-code

# OPTIONAL. Home directory of the container's claude-runner user. You only
# need to change this if you've modified the Dockerfile to use a different
# username. Defaults to "/home/claude-runner".
CDOCKER_CONTAINER_HOME=/home/claude-runner
